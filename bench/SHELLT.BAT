@ECHO OFF
D:
CD \X
ECHO --dir > C:\SH.TXT
DIR FOO.TXT /B >> C:\SH.TXT
DIR foo.txt /B >> C:\SH.TXT
DIR NOSUCH.TXT /B >> C:\SH.TXT
DIR SUBDIR /B >> C:\SH.TXT
DIR "Alpha track 000000.mid" /B >> C:\SH.TXT
DIR ALPHAT~1.MID /B >> C:\SH.TXT
DIR NOEXT /B >> C:\SH.TXT
DIR NOEXT. /B >> C:\SH.TXT
DIR *.TXT /B >> C:\SH.TXT
DIR D:\FOO.TXT /B >> C:\SH.TXT
ECHO --exist >> C:\SH.TXT
IF EXIST FOO.TXT ECHO foo yes >> C:\SH.TXT
IF EXIST NOSUCH.TXT ECHO nosuch yes >> C:\SH.TXT
IF EXIST SUBDIR\NUL ECHO subdir yes >> C:\SH.TXT
IF EXIST "Alpha track 000000.mid" ECHO long yes >> C:\SH.TXT
IF EXIST ALPHAT~1.MID ECHO alias yes >> C:\SH.TXT
IF EXIST *.MID ECHO wild yes >> C:\SH.TXT
ECHO --type >> C:\SH.TXT
TYPE FOO.TXT >> C:\SH.TXT
ECHO. >> C:\SH.TXT
TYPE ALPHAT~1.MID >> C:\SH.TXT
ECHO. >> C:\SH.TXT
TYPE NOSUCH.TXT >> C:\SH.TXT
ECHO --copy >> C:\SH.TXT
COPY BAR.TXT C:\OUT1.TXT >> C:\SH.TXT
COPY /Y BAR.TXT ZED.TXT >> C:\SH.TXT
COPY FOO.TXT NEWCOPY.TXT >> C:\SH.TXT
COPY /Y FOO.TXT+BAR.TXT JOINED.TXT >> C:\SH.TXT
COPY NOSUCH.TXT C:\OUT2.TXT >> C:\SH.TXT
ECHO --ren >> C:\SH.TXT
REN NEWCOPY.TXT RENAMED.TXT >> C:\SH.TXT
REN NOSUCH.TXT OTHER.TXT >> C:\SH.TXT
DIR RENAMED.TXT /B >> C:\SH.TXT
ECHO --del >> C:\SH.TXT
DEL RENAMED.TXT >> C:\SH.TXT
DEL NOSUCH.TXT >> C:\SH.TXT
DIR RENAMED.TXT /B >> C:\SH.TXT
ECHO --attrib >> C:\SH.TXT
ATTRIB FOO.TXT >> C:\SH.TXT
ATTRIB NOSUCH.TXT >> C:\SH.TXT
ECHO --for >> C:\SH.TXT
FOR %%F IN (FOO.TXT BAR.TXT NOSUCH.TXT *.MID) DO ECHO %%F >> C:\SH.TXT
ECHO --dirs >> C:\SH.TXT
MD NEWDIR >> C:\SH.TXT
CD NEWDIR >> C:\SH.TXT
CD .. >> C:\SH.TXT
RD NEWDIR >> C:\SH.TXT
RD SUBDIR >> C:\SH.TXT
CD SUBDIR >> C:\SH.TXT
DIR INNER.TXT /B >> C:\SH.TXT
CD .. >> C:\SH.TXT
ECHO --final >> C:\SH.TXT
DIR /B /ON >> C:\SH.TXT
C:
ECHO END>> C:\SH.TXT
